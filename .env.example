# =============================================================================
# Copy this file to .env and fill in real values. .env is git-ignored and
# should never be committed — this file (.env.example) has placeholders only
# and is safe to keep in the repo so others know what's required.
# =============================================================================

# --- Flask ---

# Signs and encrypts Flask's session cookies (login sessions, flash messages).
# Use any long, random string. If this leaks or is guessable, sessions can be
# forged. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value

# Standard Flask environment flag. Use "development" while working locally
# (enables debug mode/auto-reload) and "production" for a real deployment.
FLASK_ENV=production

# --- Data / storage paths ---
# These can be relative paths (e.g. ./data/...) — they'll be created
# automatically on first run if they don't already exist.

# Folder where uploaded meeting-minute PDFs are stored and read from.
UPLOAD_FOLDER=./data/pdfs

# Folder where per-user chat history files are written.
USER_CHAT_DIR=./data/user_chat_history

# Path to the JSON file mapping employee IDs to {name, unit, role}.
# Used for login and to decide which dashboard (employee vs head_of_unit)
# a user sees. Not auto-created — you must create this file yourself.
EMPLOYEES_FILE=./data/employees.json

# Path to the FAISS vector index for raw document text chunks, and its
# matching reference file (chunk text + source filename for each vector).
# You do NOT create these files yourself — they don't exist until you run
# the app. On first run, if nothing exists at these paths yet, the app
# builds both files automatically from your PDFs and saves them here;
# on every later run, it just loads them instead of rebuilding. You only
# need to choose *where* they should live — any writable path is fine,
# and the containing folder is created automatically if it doesn't exist.
# Delete these two files together if you ever want to force a full
# rebuild (e.g. after adding or removing PDFs).
RAW_INDEX_FILE=./data/raw_chunks.index
RAW_REFS_FILE=./data/raw_refs.pkl

# --- Local LLM (via Ollama) ---

# The model tag Ollama should use to answer questions, e.g.
# "llama3:8b-instruct-q4_0" for local development, or your deployed
# Qwen model tag in production. Must already be pulled locally
# (ollama pull <tag>) before starting the app.
LLM_MODEL_NAME=qwen

# Base URL of the local Ollama server. The default below matches
# Ollama's default port — only change this if Ollama is running on a
# different host/port.
LLM_ENDPOINT=http://localhost:11434
